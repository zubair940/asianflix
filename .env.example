# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/asianflix?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# App Configuration
PORT=3000
NODE_ENV=production

# Frontend URL (for CORS)
FRONTEND_URL=https://your-project.vercel.app

# Cloudflare R2 (S3-compatible) - cloud file storage for uploads (posters, banners, videos)
# Get these from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
# NOTE: Only needed if you use R2. The FREE option is Vercel Blob below.
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=asianflix
# Public custom domain for R2 (recommended, e.g. https://media.yourdomain.com)
# Without it, files are served through the same-origin proxy /api/r2/serve/<key>
# (works for images; a custom domain is recommended for large video streaming)
R2_PUBLIC_URL=https://media.yourdomain.com

# Vercel Blob (FREE - included with the Hobby plan, NO credit card required)
# Create it: Vercel Dashboard -> Storage -> Create Blob Store -> connect to project.
# Vercel then auto-sets BLOB_READ_WRITE_TOKEN. When set, ALL uploads (videos +
# images) go to Blob whenever R2 is not configured.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Optional: AI Features
GEMINI_API_KEY=your-gemini-api-key