# AsianFlix environment variables
# =================================
# Local dev: copy this file to .env and fill in values.
# Production: add the same keys in Vercel -> Settings -> Environment Variables.

# Database (MongoDB Atlas, free M0 tier). Needed for persistence in production.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/asianflix?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# App Configuration
PORT=3000
NODE_ENV=production

# Frontend URL (for CORS on the full-stack local server)
FRONTEND_URL=https://your-project.vercel.app

# --- Local media server (REQUIRED for media: ALL files live on your PC) ---
# 1. On your PC:         npm run media-server
# 2. Expose publicly:    cloudflared tunnel --url http://localhost:8787
# 3. Local .env on PC:   MEDIA_PUBLIC_URL=https://<printed-tunnel-url>
# 4. Vercel env:         MEDIA_SERVER_URL=https://<printed-tunnel-url>  (then redeploy)
# With MEDIA_SERVER_URL set, EVERY upload (videos, posters, banners, subtitles)
# goes directly from the browser to your PC. No cloud storage is used.

# --- Local media server settings (only used on your PC's .env) ---
# MEDIA_PORT=8787
# MEDIA_DIR=uploads
# MEDIA_PUBLIC_URL=http://localhost:8787
# MEDIA_LOG=uploads/logs/media-server.log
# CORS_ORIGIN=https://your-project.vercel.app

# Optional: AI Features
GEMINI_API_KEY=your-gemini-api-key